// Prisma schema for preps.
// Authentication models mirror the posters project exactly.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
//<--------- AUTHENTICATION MODELS----------->
enum Role {
  USER
  ADMIN
}
// TABLE-1
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  balance       Int       @default(0)
  avilableCollateral Int  @default(0)
  lockedCollateral Int    @default(0)
  emailVerified DateTime?
  role          Role     @default(USER)
  image         String?
  //Business Related Relations
  positions     Position[]
  orders        Order[]

  //Authentication Related Relations
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]  // Optional for WebAuthn support

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Position {
  id            String   @id @default(cuid())
  userId        String
  market     String
  type  String
  quantity      Int
  margin        Int
  liquidationPrice Int
  averagePrice  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Order {
  id            String   @id @default(cuid())
  userId        String
  market        String
  type          String
  quantity      Int
  margin        Int
  orderType     String
  price         Int
  status        String
  collateral    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  makerFills   Fill[] @relation("MakerOrder")
  takerFills   Fill[] @relation("TakerOrder")

}

model Fill{
  id           String   @id @default(cuid())
  MakerOrderId   String
  TakerOrderId   String
  market        String
  quantity      Int
  longPrice     Int
  shortPrice    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  MakerOrder Order @relation("MakerOrder", fields: [MakerOrderId], references: [id], onDelete: Cascade)
  TakerOrder Order @relation("TakerOrder", fields: [TakerOrderId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}
